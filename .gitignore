# ---------------------------------------------------------------------------
# Copyrighted music: kept locally for the Music app demo, never committed.
# These are commercial recordings (Kala Chashma, Believer, APT, ...). They
# were removed from this repository's history on 2026-10-10 to remove the
# copyright exposure and to cut the clone from ~250MB to ~37MB.
#
# The Music app degrades gracefully without them: it ships with empty
# tracklists rather than failing. To restore the demo locally, drop your own
# legally-obtained audio into public/music/ and update src/data/tracks.ts.
# ---------------------------------------------------------------------------
music/

# graphify knowledge-graph output: regenerable cache, not source.
# Regenerate locally with `graphify` (see .agents/rules/graphify.md).
graphify-out/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Playwright GIF capture scratch
.github/demo-frames/

# Ad-hoc reference screenshots (superseded by .github/desktop-still.png)
/New*.png
