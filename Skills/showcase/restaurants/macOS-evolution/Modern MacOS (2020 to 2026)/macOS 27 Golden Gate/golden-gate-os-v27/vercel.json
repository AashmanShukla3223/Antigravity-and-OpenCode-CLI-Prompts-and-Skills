{
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/version.json", "destination": "/version.json" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
