{
  "redirects": [
    {
      "source": "/data/cores/ppsspp-assets.zip",
      "destination": "https://cdn.emulatorjs.org/nightly/data/cores/ppsspp-assets.zip",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    }
  ]
}
