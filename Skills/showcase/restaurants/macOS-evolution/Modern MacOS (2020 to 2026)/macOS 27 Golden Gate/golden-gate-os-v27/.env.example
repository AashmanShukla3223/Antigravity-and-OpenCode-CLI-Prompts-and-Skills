# Golden Gate OS v27 - Environment Variables
# Copy this to .env and fill in your values

# API keys (users can also set these in Siri Settings UI)
# VITE_GEMINI_API_KEY=
# VITE_GROQ_API_KEY=
# VITE_OPENROUTER_API_KEY=

# Weather API (users can also set in Weather app settings)
# VITE_WEATHER_API_KEY=

# GitHub API token (used by XCode and VS Code for repo access)
# VITE_GITHUB_TOKEN=
