{
  "rootDirectory": "Skills/showcase/restaurants/macOS-evolution/Modern MacOS (2020 to 2026)/macOS 26 Tahoe/tahoe-os-v4",
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
